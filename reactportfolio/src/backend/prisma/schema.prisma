// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Projects {
  id               Int      @id @default(autoincrement())
  name             String
  shortDescription String?
  description      String
  createdAt        String
  favourited       Boolean
  publishedAt      String?
  public           Boolean @default(false)
  status           String @default("draft")

  tags             Tags[]   @relation("ProjectTags")  // Defines the one-to-many relation with Tags
}

model Tags {
  projectId Int
  tag       String

  project   Projects @relation(fields: [projectId], references: [id], name: "ProjectTags", onDelete: Cascade) // Relation back to Project

  @@id([projectId, tag])  // Composite primary key to ensure uniqueness
}