// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id Int
  name String
  shortDescription? String
  description?
  dateDay Int
  dateMonth Int
  dateYear Int
  favourited Boolean
  publishedAt DateTime
  public Boolean
  status String
}